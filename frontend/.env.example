# Optional. Demo works without this file. Copy to .env.local; never commit real values.
SCHEDULE_SOURCE=demo

# file mode: path relative to frontend/ (or an absolute path on the server).
# SCHEDULE_FILE=.local/schedule.json

# api mode: server-to-server HTTPS request; no browser CORS setup required.
# SCHEDULE_API_URL=https://example.invalid/schedule.json
# SCHEDULE_API_TOKEN=replace-with-your-server-only-bearer-token

# Optional public deployment origin for metadata (no credentials).
# SITE_URL=https://example.invalid
